{
  "name": "edy-helpdesk",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "predev": "npm run build:packages",
    "dev": "concurrently -k -n API,WEB,WORKER -c blue,cyan,green \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:worker\"",
    "dev:api": "node --env-file=.env --import tsx --watch apps/api/src/server.ts",
    "dev:web": "npm run dev -w @edy/web",
    "dev:worker": "node --env-file=.env --import tsx --watch apps/diagnostics-worker/src/index.ts",
    "start:api": "node --env-file=.env apps/api/dist/server.js",
    "start:worker": "node --env-file=.env apps/diagnostics-worker/dist/index.js",
    "preview:web": "npm run preview -w @edy/web",
    "build:packages": "npm run build -w @edy/contracts && npm run build -w @edy/domain && npm run build -w @edy/config && npm run build -w @edy/test-utils",
    "build": "npm run build:packages && npm run build -w @edy/api && npm run build -w @edy/diagnostics-worker && npm run build -w @edy/web",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.phase4-tools.json",
    "db:sync:postgresql-schema": "node scripts/generate-postgresql-schema.mjs",
    "db:generate": "prisma generate && npm run db:generate:postgresql",
    "db:generate:postgresql": "npm run db:sync:postgresql-schema && prisma generate --config prisma.postgresql.config.ts",
    "db:validate:postgresql": "npm run db:sync:postgresql-schema && prisma validate --config prisma.postgresql.config.ts",
    "db:ddl:postgresql": "npm run db:sync:postgresql-schema && prisma migrate diff --from-empty --to-schema prisma/schema.postgresql.prisma --script --output prisma/migrations-postgresql/20260829000000_v1_rc_baseline/migration.sql",
    "db:push:postgresql:test": "npm run db:sync:postgresql-schema && prisma db push --config prisma.postgresql.config.ts",
    "db:migrate": "node --env-file=.env --import tsx scripts/db-migrate.ts",
    "db:migrate:prisma": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "predb:seed": "npm run build:packages",
    "db:seed": "node --env-file=.env --import tsx prisma/seed.ts",
    "db:validate": "prisma validate",
    "backup:create": "node --env-file=.env --import tsx scripts/backup-create.ts",
    "restore:validate": "node --import tsx scripts/restore-validate.ts",
    "e2e:prepare": "node --env-file=.env --import tsx scripts/e2e-prepare.ts",
    "e2e": "npm run e2e:prepare && node --env-file=.env node_modules/@playwright/test/cli.js test",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "audit:dependencies": "npm audit --audit-level=high",
    "scan:secrets": "node scripts/secret-scan.mjs",
    "diagnostics:build-host": "node scripts/build-process-host.mjs",
    "diagnostics:qa-real": "node --import tsx scripts/qa-diagnostics-real.ts",
    "diagnostics:qa-containment": "node --import tsx scripts/qa-containment.ts",
    "smoke:phase3": "node --env-file=.env scripts/smoke-phase3.mjs",
    "smoke:phase4": "node --env-file=.env scripts/smoke-phase4.mjs",
    "smoke:phase5": "node --env-file=.env scripts/smoke-phase5.mjs",
    "smoke:phase6": "node --env-file=.env scripts/smoke-phase6.mjs",
    "smoke:phase7": "node --env-file=.env scripts/smoke-phase7.mjs",
    "qa:phase5-storage": "node scripts/qa-phase5-storage.mjs",
    "qa:phase6-performance": "node --env-file=.env --import tsx scripts/qa-phase6-performance.ts",
    "qa:phase7-performance": "node --env-file=.env --import tsx scripts/qa-phase7-performance.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.23.1",
    "better-sqlite3": "12.11.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "prisma": "7.10.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "pg": "^8.23.0"
  }
}
