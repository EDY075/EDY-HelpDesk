generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum AccountRole {
  Admin
  Technician
  Viewer
}

enum TicketPriority {
  Low
  Medium
  High
  Critical
}

enum TicketStatus {
  New
  Assigned
  InProgress
  WaitingUser
  WaitingThirdParty
  Resolved
  Closed
}

enum DiagnosticCategory {
  Windows
  Network
  Hardware
  EventLog
}

enum SecuritySeverity {
  Low
  Medium
  High
  Critical
}

enum SecurityCaseStatus {
  New
  Triaged
  Investigating
  Contained
  Resolved
  Closed
  FalsePositive
}

enum SecurityEvidenceType {
  TicketContext
  DiagnosticFinding
  EventLog
  ManualNote
}

enum OutboxStatus {
  Pending
  Processed
  Failed
  DeadLetter
}

enum ExportJobStatus {
  Queued
  Running
  Succeeded
  Failed
  Expired
}

enum ReportType {
  TicketReport
  SlaReport
  AssetReport
  DiagnosticReport
  KnowledgeReport
  SecurityCaseReport
  AuditSummary
}

enum ExportFormat {
  CSV
  JSON
}

model Department {
  id         String    @id @default(uuid())
  code       String    @unique
  name       String    @unique
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  users      User[]
  assets     Asset[]
  tickets    Ticket[]

  @@index([archivedAt])
}

model User {
  id           String     @id @default(uuid())
  displayName  String
  email        String?    @unique
  departmentId String
  archivedAt   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  accounts     Account[]
  assets       Asset[]
  tickets      Ticket[]   @relation("TicketRequester")

  @@index([departmentId, archivedAt])
}

model Account {
  id                    String                  @id @default(uuid())
  username              String                  @unique
  credentialHash        String?
  role                  AccountRole
  userId                String?                 @unique
  archivedAt            DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  user                  User?                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  assignedTickets       Ticket[]                @relation("TicketAssignee")
  comments              TicketComment[]
  historyEntries        TicketHistory[]
  sessions              Session[]
  knowledgeArticles     KnowledgeArticle[]
  assignedSecurityCases SecurityCase[]          @relation("SecurityCaseAnalyst")
  createdSecurityCases  SecurityCase[]          @relation("SecurityCaseCreator")
  securityEvidence      SecurityEvidence[]      @relation("SecurityEvidenceCreator")
  securityTimeline      SecurityTimelineEntry[] @relation("SecurityTimelineActor")
  exportJobs            ExportJob[]

  @@index([role, archivedAt])
}

model Session {
  id            String    @id @default(uuid())
  tokenHash     String    @unique
  csrfTokenHash String
  accountId     String
  expiresAt     DateTime
  lastSeenAt    DateTime  @default(now())
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())
  account       Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, revokedAt, expiresAt])
  @@index([expiresAt])
}

model Asset {
  id              String         @id @default(uuid())
  assetCode       String         @unique
  version         Int            @default(1)
  hostname        String?
  manufacturer    String?
  model           String?
  operatingSystem String?
  osVersion       String?
  cpu             String?
  ramBytes        Float?
  storageBytes    Float?
  ipv4            String?
  macAddress      String?
  status          String         @default("Active")
  location        String?
  purchaseDate    DateTime?
  warrantyUntil   DateTime?
  notes           String?
  lastSeenAt      DateTime?
  assetTag        String         @unique
  name            String
  assetType       String
  serialNumber    String?        @unique
  ownerId         String?
  departmentId    String
  archivedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  owner           User?          @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  department      Department     @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  tickets         Ticket[]
  securityCases   SecurityCase[]

  @@index([departmentId, archivedAt])
  @@index([ownerId])
  @@index([status, archivedAt])
}

model TicketCategory {
  id                String             @id @default(uuid())
  code              String             @unique
  name              String             @unique
  description       String?
  archivedAt        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  tickets           Ticket[]
  knowledgeArticles KnowledgeArticle[]

  @@index([archivedAt])
}

model Ticket {
  id                String                   @id @default(uuid())
  ticketNumber      String                   @unique
  title             String
  description       String
  priority          TicketPriority
  status            TicketStatus             @default(New)
  requesterId       String
  departmentId      String?
  categoryId        String
  assigneeAccountId String?
  assetId           String?
  slaPolicyId       String
  solution          String?
  waitingReason     String?
  resolvedAt        DateTime?
  closedAt          DateTime?
  version           Int                      @default(1)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  requester         User                     @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  department        Department?              @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  category          TicketCategory           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  assignee          Account?                 @relation("TicketAssignee", fields: [assigneeAccountId], references: [id], onDelete: Restrict)
  asset             Asset?                   @relation(fields: [assetId], references: [id], onDelete: Restrict)
  slaPolicy         SlaPolicy                @relation(fields: [slaPolicyId], references: [id], onDelete: Restrict)
  sla               TicketSla?
  comments          TicketComment[]
  history           TicketHistory[]
  securityCase      SecurityCase?
  knowledgeLinks    KnowledgeArticleTicket[]

  @@index([status, priority, createdAt])
  @@index([requesterId])
  @@index([departmentId, status])
  @@index([assigneeAccountId, status])
  @@index([categoryId])
  @@index([assetId])
}

model TicketComment {
  id              String   @id @default(uuid())
  ticketId        String
  authorAccountId String?
  body            String
  internal        Boolean  @default(false)
  createdAt       DateTime @default(now())
  ticket          Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author          Account? @relation(fields: [authorAccountId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
  @@index([authorAccountId])
}

model TicketHistory {
  id              String        @id @default(uuid())
  ticketId        String
  actorAccountId  String?
  action          String
  fromStatus      TicketStatus?
  toStatus        TicketStatus?
  previousVersion Int
  newVersion      Int
  details         Json?
  createdAt       DateTime      @default(now())
  ticket          Ticket        @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  actor           Account?      @relation(fields: [actorAccountId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
  @@index([actorAccountId])
}

model SlaPolicy {
  id                      String         @id @default(uuid())
  name                    String
  version                 Int
  priority                TicketPriority
  responseTargetMinutes   Int
  resolutionTargetMinutes Int
  atRiskThresholdMinutes  Int
  waitingThirdPartyPauses Boolean        @default(false)
  effectiveFrom           DateTime
  retiredAt               DateTime?
  createdAt               DateTime       @default(now())
  tickets                 Ticket[]
  ticketSlas              TicketSla[]

  @@unique([name, version, priority])
  @@index([priority, effectiveFrom, retiredAt])
}

model TicketSla {
  id                   String    @id @default(uuid())
  ticketId             String    @unique
  slaPolicyId          String
  responseDueAt        DateTime
  resolutionDueAt      DateTime
  firstResponseAt      DateTime?
  resolutionStoppedAt  DateTime?
  pausedAt             DateTime?
  totalPausedSeconds   Int       @default(0)
  responseBreachedAt   DateTime?
  resolutionBreachedAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  ticket               Ticket    @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  slaPolicy            SlaPolicy @relation(fields: [slaPolicyId], references: [id], onDelete: Restrict)

  @@index([responseDueAt])
  @@index([resolutionDueAt])
  @@index([slaPolicyId])
}

model DiagnosticAction {
  id                 String             @id @default(uuid())
  actionId           String
  name               String
  description        String             @default("")
  category           DiagnosticCategory
  version            Int
  scriptPath         String
  scriptHash         String
  requiredPermission String
  parameterSchema    Json
  outputSchema       Json
  timeoutMs          Int
  maxOutputBytes     Int
  requiresElevation  Boolean            @default(false)
  enabled            Boolean            @default(false)
  createdAt          DateTime           @default(now())
  jobs               DiagnosticJob[]

  @@unique([actionId, version])
  @@index([category, enabled])
}

model SecurityCase {
  id                  String                  @id @default(uuid())
  securityCaseCode    String                  @unique
  ticketId            String                  @unique
  title               String
  summary             String
  severity            SecuritySeverity
  status              SecurityCaseStatus      @default(New)
  reason              String
  assignedAnalystId   String?
  assetId             String?
  createdById         String
  resolutionSummary   String?
  classification      String?
  lessonsLearned      String?
  falsePositiveReason String?
  resolvedAt          DateTime?
  closedAt            DateTime?
  version             Int                     @default(1)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  ticket              Ticket                  @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  assignedAnalyst     Account?                @relation("SecurityCaseAnalyst", fields: [assignedAnalystId], references: [id], onDelete: Restrict)
  createdBy           Account                 @relation("SecurityCaseCreator", fields: [createdById], references: [id], onDelete: Restrict)
  asset               Asset?                  @relation(fields: [assetId], references: [id], onDelete: Restrict)
  evidence            SecurityEvidence[]
  timeline            SecurityTimelineEntry[]

  @@index([status, severity, createdAt])
  @@index([assignedAnalystId, status])
  @@index([assetId, status])
  @@index([updatedAt])
}

model SecurityEvidence {
  evidenceId      String               @id @default(uuid())
  securityCaseId  String
  type            SecurityEvidenceType
  title           String
  summary         String
  source          String
  sourceReference String?
  snapshot        Json?
  createdById     String
  createdAt       DateTime             @default(now())
  securityCase    SecurityCase         @relation(fields: [securityCaseId], references: [id], onDelete: Restrict)
  createdBy       Account              @relation("SecurityEvidenceCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([securityCaseId, type, sourceReference])
  @@index([securityCaseId, createdAt])
  @@index([type, createdAt])
}

model SecurityTimelineEntry {
  id             String       @id @default(uuid())
  securityCaseId String
  actorAccountId String?
  action         String
  summary        String
  metadata       Json?
  timestamp      DateTime     @default(now())
  securityCase   SecurityCase @relation(fields: [securityCaseId], references: [id], onDelete: Restrict)
  actor          Account?     @relation("SecurityTimelineActor", fields: [actorAccountId], references: [id], onDelete: Restrict)

  @@index([securityCaseId, timestamp])
  @@index([actorAccountId, timestamp])
}

model AuditEvent {
  id                String   @id @default(uuid())
  occurredAt        DateTime @default(now())
  actorId           String?
  actorType         String
  actorRoleSnapshot String?
  action            String
  resourceType      String
  resourceId        String?
  outcome           String
  reason            String?
  requestId         String?
  correlationId     String?
  changedFields     Json?
  metadata          Json?

  @@index([occurredAt])
  @@index([resourceType, resourceId, occurredAt])
  @@index([actorId, occurredAt])
  @@index([correlationId])
}

model IntegrationOutbox {
  id             String       @id @default(uuid())
  eventId        String       @unique
  eventType      String
  schemaVersion  Int
  occurredAt     DateTime
  source         String
  correlationId  String
  idempotencyKey String       @unique
  payload        Json
  status         OutboxStatus @default(Pending)
  attempts       Int          @default(0)
  availableAt    DateTime     @default(now())
  processedAt    DateTime?
  lastError      String?
  createdAt      DateTime     @default(now())

  @@index([status, availableAt])
}

model ExportJob {
  id          String          @id @default(uuid())
  requestedBy String
  reportType  ReportType
  filters     Json
  format      ExportFormat
  status      ExportJobStatus @default(Queued)
  requestedAt DateTime        @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  expiresAt   DateTime
  fileName    String?
  fileSize    Int?
  rowCount    Int?
  errorCode   String?
  account     Account         @relation(fields: [requestedBy], references: [id], onDelete: Restrict)

  @@index([requestedBy, requestedAt])
  @@index([status, requestedAt])
  @@index([expiresAt])
}

model SequenceCounter {
  id        String   @id @default(uuid())
  scope     String
  year      Int
  value     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([scope, year])
}

model KnowledgeArticle {
  id              String                   @id @default(uuid())
  articleCode     String                   @unique
  title           String
  summary         String
  problem         String
  symptoms        String
  diagnosticSteps String
  solution        String
  validationSteps String
  categoryId      String
  tags            String                   @default("")
  status          String                   @default("Draft")
  authorAccountId String
  version         Int                      @default(1)
  publishedAt     DateTime?
  archivedAt      DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  author          Account                  @relation(fields: [authorAccountId], references: [id], onDelete: Restrict)
  category        TicketCategory           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  ticketLinks     KnowledgeArticleTicket[]

  @@index([status, updatedAt])
  @@index([categoryId, status])
}

model KnowledgeArticleTicket {
  id        String           @id @default(uuid())
  ticketId  String
  articleId String
  createdAt DateTime         @default(now())
  ticket    Ticket           @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  article   KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Restrict)

  @@unique([ticketId, articleId])
  @@index([articleId])
}

model DeploymentState {
  id        String   @id
  mode      String
  createdAt DateTime @default(now())
}

model LocalEndpoint {
  id           String   @id
  assetId      String   @unique
  fingerprint  String
  registeredBy String
  registeredAt DateTime @default(now())
}

model DiagnosticWorkerState {
  id          String   @id
  owner       String
  fingerprint String
  heartbeatAt DateTime
  leaseUntil  DateTime
  engine      String?
  ready       Boolean  @default(false)
  errorCode   String?
}

model DiagnosticJob {
  id                String            @id @default(uuid())
  actionId          String
  actionRecordId    String
  assetId           String
  requestedBy       String
  requestedAt       DateTime          @default(now())
  startedAt         DateTime?
  completedAt       DateTime?
  status            String            @default("Queued")
  parameters        Json
  idempotencyKey    String
  requestId         String?
  correlationId     String?
  scriptVersion     Int
  scriptHash        String
  engine            String?
  outputBytes       Int               @default(0)
  durationMs        Int?
  exitCode          Int?
  errorCode         String?
  cancelRequestedAt DateTime?
  owner             String?
  sourceMode        String
  expiresAt         DateTime
  action            DiagnosticAction  @relation(fields: [actionRecordId], references: [id], onDelete: Restrict)
  result            DiagnosticResult?

  @@unique([requestedBy, idempotencyKey])
  @@index([status, requestedAt])
  @@index([assetId, requestedAt])
}

model DiagnosticResult {
  id             String         @id @default(uuid())
  jobId          String         @unique
  assetId        String
  actionId       String
  collectedAt    DateTime
  payload        Json
  findings       Json
  ruleVersion    Int            @default(1)
  sourceMode     String
  redactionCount Int            @default(0)
  expiresAt      DateTime
  job            DiagnosticJob  @relation(fields: [jobId], references: [id], onDelete: Restrict)
  events         WindowsEvent[]

  @@index([assetId, collectedAt])
  @@index([expiresAt])
}

model WindowsEvent {
  id        String           @id @default(uuid())
  resultId  String
  timestamp DateTime
  eventId   Int
  level     String
  provider  String
  message   String
  expiresAt DateTime
  result    DiagnosticResult @relation(fields: [resultId], references: [id], onDelete: Restrict)

  @@index([resultId, timestamp])
  @@index([expiresAt])
}
